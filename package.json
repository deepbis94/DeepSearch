{
  "name": "deepsearch",
  "version": "1.0.0",
  "description": "AI research agent that searches the web, reads pages, and produces cited reports",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test:research": "tsx scripts/test-research.ts",
    "poll:research": "bash scripts/poll-research.sh",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "research",
    "ai",
    "agent",
    "openai",
    "react"
  ],
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsdom": "^26.0.0",
    "openai": "^4.85.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
